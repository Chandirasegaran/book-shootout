# Copy to .env next to compose.yaml.

# Port the game listens on, on the server.
# Behind a reverse proxy already on the server (e.g. a host Caddy or nginx),
# use PORT=127.0.0.1:5002 so the game is only reachable through the proxy.
PORT=5002

# Your domain, for HTTPS with `docker compose --profile https up -d`.
# Its DNS must point at this server, and ports 80 and 443 must be open.
DOMAIN=game.example.com
